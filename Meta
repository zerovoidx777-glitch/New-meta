local function updatePlayerList()
    playerList = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isEnemy(plr) then
            table.insert(playerList, plr)
        end
    end
    
    if #playerList == 0 then
        TargetPlayer = nil
        TargetLabel.Text = "ไม่มีศัตรูในรายการ"
    else
        if targetIndex > #playerList then targetIndex = 1 end
        if targetIndex < 1 then targetIndex = #playerList end
        TargetPlayer = playerList[targetIndex]
        TargetLabel.Text = TargetPlayer.DisplayName or TargetPlayer.Name
    end
end

PrevBtn.MouseButton1Click:Connect(function()
    if #playerList > 0 then
        targetIndex = targetIndex - 1
        if targetIndex < 1 then targetIndex = #playerList end
        updatePlayerList()
    end
end)

NextBtn.MouseButton1Click:Connect(function()
    if #playerList > 0 then
        targetIndex = targetIndex + 1
        if targetIndex > #playerList then targetIndex = 1 end
        updatePlayerList()
    end
end)

RefreshBtn.MouseButton1Click:Connect(function()
    updatePlayerList()
end)

