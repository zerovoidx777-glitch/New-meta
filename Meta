-- ESP Function
local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local hl = char:FindFirstChild("LS_ESP_HL")
            local bg = char:FindFirstChild("LS_ESP_BG")
            
            if ESP_Enabled and isEnemy(plr) then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "LS_ESP_HL"
                    hl.FillColor = Color3.fromRGB(180, 50, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.Parent = char
                end
                
                if not bg and char:FindFirstChild("Head") then
                    bg = Instance.new("BillboardGui")
                    bg.Name = "LS_ESP_BG"
                    bg.AlwaysOnTop = true
                    bg.Size = UDim2.new(0, 120, 0, 30)
                    bg.StudsOffset = Vector3.new(0, 3, 0)
                    bg.Adornee = char.Head
                    bg.Parent = char
                    
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "👤 " .. (plr.DisplayName or plr.Name)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    lbl.TextStrokeTransparency = 0
                    lbl.TextSize = 12
                    lbl.Font = Enum.Font.SourceSansBold
                    lbl.Parent = bg
                end
            else
                if hl then hl:Destroy() end
                if bg then bg:Destroy() end
            end
        end
    end
end

-- =========================================================
-- 🔄 MAIN RENDER LOOP
-- =========================================================
RunService.RenderStepped:Connect(function(dt)
    -- Aimbot Execution with Snap Break & FOV Check (Hold Right Click)
    if Aimbot_Enabled and IsAimbotActive then
        local enemyHead = getClosestEnemyHeadInFOV()
        if enemyHead then
            workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, enemyHead.Position)
        end
    end

    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum then
            -- Noclip
            if Noclip or Follow_Enabled or Orbit_Enabled then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
            
            -- Fly Follow Target
            if Follow_Enabled and TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local tHrp = TargetPlayer.Character.HumanoidRootPart
                hrp.CFrame = tHrp.CFrame * CFrame.new(0, 2, 4)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            
            -- Orbit Target
            if Orbit_Enabled and TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local tHrp = TargetPlayer.Character.HumanoidRootPart
                orbitAngle = orbitAngle + (180 * dt)
                local rad = math.rad(orbitAngle)
                local offset = Vector3.new(math.sin(rad) * 6, 2, math.cos(rad) * 6)
                hrp.CFrame = CFrame.new(tHrp.Position + offset, tHrp.Position)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            
            -- Spinbot
            if Spin_Enabled then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(25), 0)
            end
            
            -- Vehicle Speed
            if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                local seat = hum.SeatPart
                seat.MaxSpeed = VehicleSpeed
                if seat.Throttle ~= 0 then
                    seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (seat.Throttle * VehicleSpeed)
                end
            end
            
            -- 3D Flying
            if Flying and not Follow_Enabled and not Orbit_Enabled then
                hum.PlatformStand = true
                
                if not bodyVel or bodyVel.Parent ~= hrp then
                    if hrp:FindFirstChild("LS_FlyVel") then hrp.LS_FlyVel:Destroy() end
                    bodyVel = Instance.new("BodyVelocity")
                    bodyVel.Name = "LS_FlyVel"
                    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bodyVel.Velocity = Vector3.zero
                    bodyVel.Parent = hrp
                end
                
                local cam = workspace.CurrentCamera
                local moveDir = hum.MoveDirection
                
                if moveDir.Magnitude > 0 then
                    local localMove = cam.CFrame:VectorToObjectSpace(moveDir)
                    local flyDir = (cam.CFrame.LookVector * -localMove.Z) + (cam.CFrame.RightVector * localMove.X)
                    
                    if flyDir.Magnitude > 0 then
                        hrp.CFrame = hrp.CFrame + (flyDir.Unit * (FlySpeed * dt))
                    end
                end
                
                bodyVel.Velocity = Vector3.zero
            end
        end
    end
    
    updateESP()
end)
